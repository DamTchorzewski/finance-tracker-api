{
  "openapi": "3.1.0",
  "info": {
    "title": "Finance tracker API",
    "version": "2.0.0",
    "description": "The data of the signed-in user. Accounts and sign-in are Firebase Authentication: send the Firebase ID token as `Authorization: Bearer <token>`. Amounts are integers in minor units (grosze, cents) with an ISO 4217 code."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase ID token"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "uid": {
                "type": "string"
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "emailVerified": {
                "type": "boolean"
              }
            },
            "required": [
              "uid",
              "email",
              "name",
              "emailVerified"
            ]
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": [
          "user",
          "profile"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 60
          },
          "baseCurrency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "example": "PLN"
          },
          "locale": {
            "type": "string",
            "enum": [
              "pl",
              "en"
            ]
          },
          "monthStartDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 28
          },
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          },
          "accentHue": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359
          },
          "privacyMode": {
            "type": "boolean"
          },
          "widgets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "balance",
                "cashflow",
                "spending",
                "budgets",
                "recent",
                "rates",
                "upcoming"
              ]
            },
            "maxItems": 7
          }
        },
        "required": [
          "displayName",
          "baseCurrency",
          "locale",
          "monthStartDay",
          "theme",
          "accentHue",
          "privacyMode",
          "widgets"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "bad_request",
                  "validation",
                  "unauthorized",
                  "forbidden",
                  "not_found",
                  "conflict",
                  "payload_too_large",
                  "rate_limited",
                  "upstream_unavailable",
                  "internal"
                ]
              },
              "message": {
                "type": "string"
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ProfilePatch": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 60
          },
          "baseCurrency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "example": "PLN"
          },
          "locale": {
            "type": "string",
            "enum": [
              "pl",
              "en"
            ]
          },
          "monthStartDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 28
          },
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          },
          "accentHue": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359
          },
          "privacyMode": {
            "type": "boolean"
          },
          "widgets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "balance",
                "cashflow",
                "spending",
                "budgets",
                "recent",
                "rates",
                "upcoming"
              ]
            },
            "maxItems": 7
          }
        },
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness check; it does not touch Firestore",
        "responses": {
          "200": {
            "description": "The API runs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "The signed-in user and their settings (defaults until they change one)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User and profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/me/profile": {
      "patch": {
        "tags": [
          "Profile"
        ],
        "summary": "Change some settings; the fields that are not sent keep their value",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "description": "validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
