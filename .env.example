# Copy to .env (git-ignored) and fill in. Standard: reops/standards/env.md
# Names only: no value is ever written here. Defaults live in the code (src/env.ts).
# There is no secret: on Google Cloud the API runs as a service account, so it needs no key.

# --- Server -----------------------------------------------------------------------------------------------

# Port the API listens on. Optional. Empty = 8080 (Cloud Run sets it itself).
PORT=

# Web origins allowed to call the API from another origin, comma separated. Optional. Empty = CORS off: in
# production the web app calls /api on its own origin (Firebase Hosting rewrites it to Cloud Run). Locally the
# Vite dev server's origin.
CORS_ORIGIN=

# Requests per minute and signed-in user before 429. Optional. Empty = 120.
RATE_LIMIT_PER_MINUTE=

# --- Firebase (Authentication and Firestore) ------------------------------------------------------------

# ID of the Firebase / Google Cloud project that holds the users and the data. Optional on Cloud Run (the project
# of the service), required locally. GitHub: environment variable GCP_PROJECT_ID.
FIREBASE_PROJECT_ID=

# "false" lets users in before they confirm their e-mail address. Optional. Empty = confirmation is required.
REQUIRE_VERIFIED_EMAIL=

# --- Local work only (never on Cloud Run) -----------------------------------------------------------------

# Path of a service account key file, to use the real project from a laptop. Optional.
GOOGLE_APPLICATION_CREDENTIALS=

# Host and port of the Firebase emulators, to work without a project. Optional.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# --- Health check (scripts/health-check.ts) -----------------------------------------------------------------

# Origin of the live API or of the web app that rewrites /api. Required by `pnpm health`.
API_URL=
