# Copy to .env (git-ignored) and fill in. Standard: reops/standards/env.md
# Names only: no value is ever written here. Defaults live in the code.

# --- Server -----------------------------------------------------------------------------------------------

# Port the API listens on. Required (the server does not start without it).
PORT=

# MongoDB connection string (MongoDB Atlas or a local server). SECRET. Required.
DB_HOST=

# --- Authentication ---------------------------------------------------------------------------------------

# Secret that signs and checks the JWT access tokens (one hour). SECRET. Required.
SECRET_KEY=

# --- E-mail (verification messages, nodemailer) ------------------------------------------------------------

# SMTP server, port, user and password (key) of the sender. The user is also the "from" address. SECRETS.
# Required for sign-up: without them the user is saved but the verification e-mail is not sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_KEY=
